{{#page}}
  <!DOCTYPE HTML>
  <link rel="stylesheet" href="/stylesheet.css"/>
  <link rel="stylesheet" href="/modified.css"/>
  <script rel="script" href="/script.js"></script>
  <html class="govuk-template govuk-template--rebranded" lang="en">

    {{$head}}{{>partials/_header}}{{/head}}
    {{#hasNavigation}}{{>partials/_navigation}}{{/hasNavigation}}

    <body>
    <div class="govuk-width-container">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
          {{#backUrl}}{{<partials/_back}}{{$backUrl}}{{backUrl}}{{/backUrl}}{{/partials/_back}}{{/backUrl}}
        </div>
      </div>
      <main class="govuk-main-wrapper--l main-content">
        {{$preTitle}}{{/preTitle}}
        {{$title}}
          <h1 class="govuk-heading-l">
            {{#i18n}}{{groupStem}}.title{{/i18n}}
          </h1>
        {{/title}}
        {{$page}}{{/page}}
      </main>
    </div>
    {{$footer}}{{>partials/_footer}}{{/footer}}
    </body>
  </html>
{{/page}}
